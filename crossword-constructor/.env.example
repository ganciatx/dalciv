# Required — generate with: openssl rand -hex 32
AUTH_SECRET=

# Dev: Vite proxies /auth to the auth server (default http://localhost:5173)
# Prod: set to your public origin, e.g. https://crosscreate.example.com
AUTH_URL=http://localhost:5173

# OAuth providers (optional — only configured providers appear in the sign-in UI)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth server port (dev only; Vite proxies to this)
PORT=3001
